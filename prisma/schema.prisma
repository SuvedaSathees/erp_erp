  attachments             CapacityAttachment[]
  approvals               CapacityApprovalStep[]
  activities              CapacityActivityLog[]
  aiAssessment            CapacityAiAssessment?
  simulations             CapacitySimulation[]
  bottlenecks             BottleneckAnalysis[]

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model CapacityAttachment {
