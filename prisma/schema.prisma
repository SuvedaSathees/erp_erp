// CRM — Customer Relationship Management
// ==========================================

enum LeadStatusEnum {
  New
  Contacted
  Qualified
  Nurturing
  Proposal
  Negotiation
  Converted
  Lost
  Disqualified
}

enum LeadRating {
  Hot
  Warm
  Cold
}

enum LeadPriority {
  Critical
  High
  Medium
  Low
}

model CrmLead {
  id                    String          @id @default(cuid())
  leadNumber            String          @unique
  leadName              String
  leadType              String          @default("Business")
  status                LeadStatusEnum  @default(New)
  rating                LeadRating      @default(Warm)
  priority              LeadPriority    @default(Medium)

  ownerName             String
  ownerEmail            String?
  businessUnit          String?
  branch                String?
  department            String?

  leadSource            String?
  sourceCampaign        String?
  sourceChannel         String?

  contactPerson         String?
  contactDesignation    String?
  email                 String?
  phone                 String?
  website               String?

  orgName               String?
  industry              String?
  companySize           String?
  annualRevenue         String?
  gstin                 String?

  city                  String?
  state                 String?
  country               String?         @default("India")
  postalCode            String?

  requirementType       String?
  productService        String?
  budget                String?
  expectedPurchaseDate  DateTime?

  qualificationScore    Int             @default(0)
  totalScore            Int             @default(0)
  scoreGrade            String?
  probability           String?

  nextAction            String?
  nextActionDate        DateTime?

  description           String?
  expectedConversionDate DateTime?

  opportunities         CrmOpportunity[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

enum OpportunityStage {
  Discovery
  Qualification
  Proposal
  Negotiation
  ClosedWon
  ClosedLost
}

model CrmOpportunity {
  id                String            @id @default(cuid())
  opportunityNumber String            @unique
  name              String
  stage             OpportunityStage  @default(Discovery)
  amount            Decimal           @default(0) @db.Decimal(18, 2)
  probability       Int               @default(0)
  expectedCloseDate DateTime?
  ownerName         String
  ownerEmail        String?

  leadId            String?
  lead              CrmLead?          @relation(fields: [leadId], references: [id])
  accountId         String?
  account           CrmAccount?       @relation(fields: [accountId], references: [id])

  productService    String?
  competitor        String?
  nextStep          String?
  description       String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CrmAccount {
  id              String           @id @default(cuid())
  accountCode     String           @unique
  name            String
  type            String           @default("Customer")
  industry        String?
  website         String?
  phone           String?
  email           String?
  annualRevenue   Decimal?         @db.Decimal(18, 2)
  employeeCount   Int?
  status          String           @default("Active")

  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingCountry  String?          @default("India")

  ownerName       String?
  parentAccountId String?
  parentAccount   CrmAccount?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   CrmAccount[]     @relation("AccountHierarchy")

  contacts        CrmContact[]
  opportunities   CrmOpportunity[]
  supportTickets  SupportTicket[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CrmContact {
  id              String      @id @default(cuid())
  contactCode     String      @unique
  firstName       String
  lastName        String
  fullName        String
  email           String?
  phone           String?
  mobile          String?
  designation     String?
  department      String?
  isPrimary       Boolean     @default(false)
  status          String      @default("Active")

  accountId       String?
  account         CrmAccount? @relation(fields: [accountId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
  Escalated
}

enum TicketPriority {
  Critical
  High
  Medium
  Low
}

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  subject       String
  description   String?
  status        TicketStatus   @default(Open)
  priority      TicketPriority @default(Medium)
  category      String?
  channel       String?        @default("Email")

  accountId     String?
  account       CrmAccount?    @relation(fields: [accountId], references: [id])
  contactName   String?
  contactEmail  String?

  assignedTo    String?
  slaDeadline   DateTime?
  resolvedAt    DateTime?
  resolution    String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

