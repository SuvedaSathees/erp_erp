// ==========================================
// HRM — Human Resource Management Models
// ==========================================

enum EmployeeStatus {
  Active
  OnLeave
  Suspended
  Resigned
  NoticePeriod
  Separated
  Retired
}

enum EmploymentType {
  FullTime
  PartTime
  Contract
  Intern
  Consultant
}

enum Gender {
  Male
  Female
  Other
}

model Department {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String       @unique
  parentId      String?
  parent        Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[] @relation("DepartmentHierarchy")
  headOfDept    String?
  costCenterCode String?
  location      String?
  status        String       @default("Active")
  employeeCount Int          @default(0)

  employees     Employee[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Designation {
  id          String     @id @default(cuid())
  code        String     @unique
  title       String     @unique
  grade       String?
  level       Int        @default(1)
  band        String?
  department  String?

  employees   Employee[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Employee {
  id                String          @id @default(cuid())
  employeeCode      String          @unique
  employeeNumber    String?
  firstName         String
  lastName          String
  fullName          String
  email             String          @unique
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?
  photo             String?

  departmentId      String?
  department        Department?     @relation(fields: [departmentId], references: [id])
  designationId     String?
  designation       Designation?    @relation(fields: [designationId], references: [id])

  status            EmployeeStatus  @default(Active)
  employmentType    EmploymentType  @default(FullTime)
  joiningDate       DateTime
  confirmationDate  DateTime?
  resignationDate   DateTime?
  lastWorkingDay    DateTime?

  reportingManagerId String?
  reportingManager   Employee?      @relation("EmployeeHierarchy", fields: [reportingManagerId], references: [id])
  directReports      Employee[]     @relation("EmployeeHierarchy")

  location          String?
  branch            String?
  businessUnit      String?
  costCenterCode    String?
  grade             String?

  annualCTC         Decimal?        @db.Decimal(18, 2)
  basicSalary       Decimal?        @db.Decimal(18, 2)
  bankAccountNo     String?
  bankName          String?
  panNumber         String?
  aadharNumber      String?
  pfNumber          String?
  esiNumber         String?

  leaveRequests     LeaveRequest[]
  attendanceRecords Attendance[]
  payrollRecords    PayrollRecord[]
  timeEntries       TimeEntry[]
  assignedTasks     ProjectTask[]   @relation("TaskAssignee")

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum LeaveType {
  CasualLeave
  SickLeave
  EarnedLeave
  MaternityLeave
  PaternityLeave
  CompensatoryOff
  LossOfPay
  Bereavement
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

model LeaveRequest {
  id            String       @id @default(cuid())
  leaveCode     String       @unique
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType    @default(CasualLeave)
  startDate     DateTime
  endDate       DateTime
  days          Float        @default(1)
  reason        String?
  status        LeaveStatus  @default(Pending)
  approvedBy    String?
  approvedDate  DateTime?
  remarks       String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum AttendanceStatus {
  Present
  Absent
  HalfDay
  OnLeave
  Holiday
  WeekOff
  WFH
}

model Attendance {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  hoursWorked   Float?
  status        AttendanceStatus @default(Present)
  shift         String?          @default("General")
  overtime      Float?           @default(0)
  remarks       String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
}

enum PayrollStatus {
  Draft
  Processing
  Approved
  Paid
  OnHold
}

model PayrollRecord {
  id                String        @id @default(cuid())
  payrollCode       String        @unique
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period            String
  month             Int
  year              Int

  basicSalary       Decimal       @default(0) @db.Decimal(18, 2)
  hra               Decimal       @default(0) @db.Decimal(18, 2)
  conveyance        Decimal       @default(0) @db.Decimal(18, 2)
  specialAllowance  Decimal       @default(0) @db.Decimal(18, 2)
  otherAllowances   Decimal       @default(0) @db.Decimal(18, 2)
  grossEarnings     Decimal       @default(0) @db.Decimal(18, 2)

  pfDeduction       Decimal       @default(0) @db.Decimal(18, 2)
  esiDeduction      Decimal       @default(0) @db.Decimal(18, 2)
  tds               Decimal       @default(0) @db.Decimal(18, 2)
  professionalTax   Decimal       @default(0) @db.Decimal(18, 2)
  otherDeductions   Decimal       @default(0) @db.Decimal(18, 2)
  totalDeductions   Decimal       @default(0) @db.Decimal(18, 2)

  netPay            Decimal       @default(0) @db.Decimal(18, 2)
  status            PayrollStatus @default(Draft)
  paidDate          DateTime?
  paymentMethod     String?       @default("Bank Transfer")

  workingDays       Int           @default(0)
  presentDays       Int           @default(0)
  lossOfPayDays     Int           @default(0)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

