model CapacityApprovalStep {
  id           String           @id @default(cuid())
  planningId   String
  planning     CapacityPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  role         String
  person       String
  decision     String           @default("Pending")
  date         DateTime?
  comments     String?
  status       String           @default("Pending")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model CapacityActivityLog {
  id           String           @id @default(cuid())
  planningId   String
  planning     CapacityPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  user         String
  action       String
  description  String
  prevStatus   String?
  newStatus    String?
  timestamp    DateTime         @default(now())
}

model CapacityAiAssessment {
  id                      String           @id @default(cuid())
  planningId              String           @unique
  planning                CapacityPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  demandForecastInsight   String
  capacityOptimization    String
  bottleneckPrediction    String
  expansionRecommendation String
  workforceOptimization   String
  aiCapacityScore         Int              @default(88)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model CapacitySimulation {
  id                      String           @id @default(cuid())
  planningId              String
  planning                CapacityPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  scenarioName            String
  simulationScore         Int              @default(86)
  expansionRequirement    String
  passed                  Boolean          @default(true)
  runDate                 DateTime         @default(now())
}

model BottleneckAnalysis {
  id                      String           @id @default(cuid())
  planningId              String
  planning                CapacityPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  workstation             String
  equipment               String
  constraint              String
  impact                  String           @default("High")
  rootCause               String?
  improvementActions      String?
  estimatedGain           String?
  createdAt               DateTime         @default(now())
}

