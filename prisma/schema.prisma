  invoice            PayableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentDate        DateTime
  amount             Decimal        @default(0) @db.Decimal(18, 2)
  paymentMethod      String         @default("Bank Transfer")
  reference          String?
  notes              String?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model PayableAttachment {
  id                 String         @id @default(cuid())
  invoiceId          String
  invoice            PayableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileName           String
  fileType           String
  documentType       String
  version            String         @default("v1.0")
  uploadedBy         String
  uploadedDate       DateTime       @default(now())
  fileSize           String
  status             String         @default("Active")
  downloadUrl        String?
  createdAt          DateTime       @default(now())
}

model PayableApprovalStep {
  id                 String         @id @default(cuid())
  invoiceId          String
  invoice            PayableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  role               String
  person             String
  decision           String         @default("Pending")
  date               DateTime?
  comments           String?
  status             String         @default("Pending")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model PayableActivityLog {
  id                 String         @id @default(cuid())
  invoiceId          String
  invoice            PayableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user               String
  action             String
  description        String
  prevStatus         String?
  newStatus          String?
  timestamp          DateTime       @default(now())
}

model ReceivableInvoice {
  id                 String                  @id @default(cuid())
  invoiceNo          String                  @unique

  customerId         String?
  customer           Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String                  // Denormalized for fast listing & filtering

  invoiceDate        DateTime
  dueDate            DateTime
  amount             Decimal                 @default(0) @db.Decimal(18, 2)
  dueAmount          Decimal                 @default(0) @db.Decimal(18, 2)
  status             ReceivableInvoiceStatus @default(DueSoon)

  // Credit memo support
  isCreditMemo       Boolean                 @default(false)
  creditMemoReason   String?

  // GL & Ledger references
  accountCode        String?                 @default("1120")
  companyId          String?
  fiscalYear         String?

  subtotal           Decimal?                @db.Decimal(18, 2)
  taxAmount          Decimal?                @db.Decimal(18, 2)
  taxRate            Float?                  @default(0.0)

  receipts           ReceivableReceipt[]
  attachments        ReceivableAttachment[]
  activities         ReceivableActivityLog[]

  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model ReceivableReceipt {
  id                 String            @id @default(cuid())
  receiptId          String            @unique @default(cuid())
  invoiceId          String
  invoice            ReceivableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptDate        DateTime
  amount             Decimal           @default(0) @db.Decimal(18, 2)
  paymentMethod      String            @default("Bank Transfer")
  reference          String?
  notes              String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ReceivableAttachment {
  id                 String            @id @default(cuid())
  invoiceId          String
  invoice            ReceivableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileName           String
  fileType           String
  documentType       String
  version            String            @default("v1.0")
  uploadedBy         String
  uploadedDate       DateTime          @default(now())
  fileSize           String
  status             String            @default("Active")
  downloadUrl        String?
  createdAt          DateTime          @default(now())
}

model ReceivableActivityLog {
  id                 String            @id @default(cuid())
  invoiceId          String
  invoice            ReceivableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user               String
  action             String
  description        String
  prevStatus         String?
  newStatus          String?
  timestamp          DateTime          @default(now())
}

