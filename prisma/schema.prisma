  requestedBy     String?
  approvedBy      String?
  approvedDate    DateTime?

  notes           String?

  lines           PurchaseOrderLine[]
  goodsReceipts   GoodsReceipt[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  lineNumber    Int
  itemCode      String
  itemName      String
  quantity      Int           @default(1)
  receivedQty   Int           @default(0)
  unitPrice     Decimal       @default(0) @db.Decimal(18, 2)
  taxRate       Float         @default(0)
  lineTotal     Decimal       @default(0) @db.Decimal(18, 2)
  uom           String        @default("Nos")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum GoodsReceiptStatus {
  Pending
  Inspecting
  Accepted
  Rejected
  PartiallyAccepted
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  grnNumber       String             @unique
  receiptDate     DateTime
  poId            String?
  po              PurchaseOrder?     @relation(fields: [poId], references: [id])
  supplierName    String
  status          GoodsReceiptStatus @default(Pending)
  receivedBy      String?
  inspectedBy     String?
  warehouseLocation String?
  remarks         String?

  lines           GoodsReceiptLine[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model GoodsReceiptLine {
  id              String       @id @default(cuid())
  grnId           String
  grn             GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  orderedQty      Int          @default(0)
  receivedQty     Int          @default(0)
  acceptedQty     Int          @default(0)
  rejectedQty     Int          @default(0)
  uom             String       @default("Nos")
  remarks         String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ==========================================
// Project Management Models
// ==========================================

enum ProjectStatus {
  Planning
  Active
  OnHold
  Completed
  Cancelled
}

enum ProjectPriority {
  Critical
  High
  Medium
  Low
}

model Project {
  id              String          @id @default(cuid())
  projectCode     String          @unique
  name            String
  description     String?
  status          ProjectStatus   @default(Planning)
  priority        ProjectPriority @default(Medium)
  category        String?

  startDate       DateTime?
  endDate         DateTime?
  actualEndDate   DateTime?

  projectManager  String
  department      String?
  clientName      String?

  budget          Decimal?        @db.Decimal(18, 2)
  actualCost      Decimal?        @db.Decimal(18, 2)
  completion      Float           @default(0)

  tasks           ProjectTask[]
  milestones      Milestone[]
  timeEntries     TimeEntry[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum TaskStatus {
  Todo
  InProgress
  InReview
  Done
  Blocked
  Cancelled
}

enum TaskPriorityEnum {
  Critical
  High
  Medium
  Low
}

model ProjectTask {
  id            String           @id @default(cuid())
  taskCode      String           @unique
  title         String
  description   String?
  status        TaskStatus       @default(Todo)
  priority      TaskPriorityEnum @default(Medium)

  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId    String?
  assignee      Employee?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeName  String?

  milestoneId   String?
  milestone     Milestone?       @relation(fields: [milestoneId], references: [id])

  startDate     DateTime?
  dueDate       DateTime?
  completedDate DateTime?
  estimatedHours Float?
  actualHours    Float?

  parentTaskId  String?
  parentTask    ProjectTask?     @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks      ProjectTask[]    @relation("TaskHierarchy")

  tags          String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum MilestoneStatus {
  Upcoming
  InProgress
  Completed
  Overdue
  Cancelled
}

model Milestone {
  id            String          @id @default(cuid())
  milestoneCode String          @unique
  name          String
  description   String?
  status        MilestoneStatus @default(Upcoming)

  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  dueDate       DateTime?
  completedDate DateTime?
  deliverables  String?
  owner         String?

  tasks         ProjectTask[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TimeEntry {
  id            String    @id @default(cuid())
  entryCode     String    @unique
  date          DateTime
  hours         Float
  description   String?

  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  employeeName  String?

  taskCode      String?
  billable      Boolean   @default(true)
  status        String    @default("Submitted")
  approvedBy    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==========================================
// Administration & Governance Models
// ==========================================

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  module      String
  entity      String?
  entityId    String?
  description String?
  performedBy String
  ipAddress   String?
  userAgent   String?
  oldValue    String?
  newValue    String?
  timestamp   DateTime @default(now())

  createdAt   DateTime @default(now())
}

model Policy {
  id            String   @id @default(cuid())
  policyCode    String   @unique
  title         String
  category      String
  version       String   @default("1.0")
  status        String   @default("Active")
  effectiveDate DateTime
  reviewDate    DateTime?
  owner         String
  department    String?
  description   String?
  documentUrl   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum DocumentStatus {
  Draft
  InReview
  Approved
  Published
  Archived
  Obsolete
}

model DocumentControl {
  id             String         @id @default(cuid())
  documentCode   String         @unique
  title          String
  type           String
  category       String?
  version        String         @default("1.0")
  status         DocumentStatus @default(Draft)
  owner          String
  department     String?
  effectiveDate  DateTime?
  expiryDate     DateTime?
  reviewDate     DateTime?
  description    String?
  filePath       String?
  accessLevel    String         @default("Internal")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ApprovalMatrix {
  id              String   @id @default(cuid())
  matrixCode      String   @unique
  module          String
  transactionType String
  minAmount       Decimal? @db.Decimal(18, 2)
  maxAmount       Decimal? @db.Decimal(18, 2)
  approverRole    String
  approverName    String?
  level           Int      @default(1)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// Quality Management Models
// ==========================================

enum CapaType {
  Corrective
  Preventive
  Both
}

enum CapaStatus {
  Open
  InvestigationPending
  RootCauseIdentified
  ActionPlanned
  ActionInProgress
  VerificationPending
  Closed
  Rejected
}

enum CapaPriority {
  Critical
  High
  Medium
  Low
}

model CapaRecord {
  id              String       @id @default(cuid())
  capaNumber      String       @unique
  title           String
  type            CapaType     @default(Corrective)
  status          CapaStatus   @default(Open)
  priority        CapaPriority @default(Medium)
  source          String?
  department      String?
  assignedTo      String?
  initiatedBy     String?
  initiatedDate   DateTime     @default(now())

  problemStatement String?
  rootCause        String?
  rootCauseMethod  String?
  actionPlan       String?
  targetDate       DateTime?
  completionDate   DateTime?
  verification     String?
  effectiveness    String?

  relatedNcrId     String?
  relatedNcr       NcrRecord?   @relation(fields: [relatedNcrId], references: [id])

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

enum NcrStatus {
  Open
  UnderReview
  Dispositioned
  Closed
  Rejected
}

model NcrRecord {
  id              String    @id @default(cuid())
  ncrNumber       String    @unique
  title           String
  description     String?
  status          NcrStatus @default(Open)
  severity        String    @default("Major")
  category        String?
  department      String?
  detectedBy      String?
  detectedDate    DateTime  @default(now())

  productCode     String?
  productName     String?
  batchNumber     String?
  quantity         Int?
  defectType      String?
  disposition     String?

  assignedTo      String?
  targetDate      DateTime?
  closedDate      DateTime?

  capas           CapaRecord[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum InspectionType {
  Incoming
  InProcess
  Final
}

enum InspectionResult {
  Pass
  Fail
  ConditionalPass
  Pending
}

model InspectionRecord {
  id              String           @id @default(cuid())
  inspectionCode  String           @unique
  type            InspectionType   @default(Incoming)
  result          InspectionResult @default(Pending)
  inspectionDate  DateTime
  inspector       String
  department      String?

  productCode     String?
  productName     String?
  batchNumber     String?
  sampleSize      Int?
  defectsFound    Int              @default(0)
  acceptanceLevel String?

  supplierName    String?
  poNumber        String?
  grnNumber       String?

  remarks         String?
  ncrRequired     Boolean          @default(false)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}
