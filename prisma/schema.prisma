  workflowStatus          String               @default("In Progress")
  stage                   Int                  @default(2)
  createdOn               DateTime             @default(now())
  dateCreated             DateTime             @default(now())
  lastModified            DateTime             @updatedAt
  lastUpdated             DateTime             @updatedAt

  plantName               String
  businessUnit            String
  engineerName            String
  planningPeriod          String               @default("Jul 2024 - Jun 2025")
  developmentStage        String               @default("Capacity Assessment")
  nextReviewDate          DateTime?

  demandForecastUnits     Int                  @default(120000)
  plannedProductionUnits Int                  @default(118000)
  capacityUtilization     Float                @default(78.0)
  oeePercentage           Float                @default(82.0)
  bottleneckCount         Int                  @default(2)

  // Scores
  assessmentScore         Int                  @default(88)
  resourceScore           Int                  @default(86)
  bottleneckScore         Int                  @default(85)
  simulationScore         Int                  @default(86)
  performanceScore        Int                  @default(84)
  aiCapacityScore         Int                  @default(88)
  overallReadinessScore   Int                  @default(87)
